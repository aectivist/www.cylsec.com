[Unit]
Description=Cylvern CTF Platform (gunicorn)
After=network.target

[Service]
User=root
WorkingDirectory=/root/www.cylsec.com/CTF
Environment="PATH=/root/www.cylsec.com/CTF/venv/bin"
EnvironmentFile=/root/www.cylsec.com/CTF/.env
ExecStart=/bin/bash /root/www.cylsec.com/CTF/entrypoint.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
