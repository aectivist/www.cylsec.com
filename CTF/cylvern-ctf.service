[Unit]
Description=Cylvern CTF Platform (gunicorn)
After=network.target

[Service]
User=root
WorkingDirectory=/root/www.cylsec.com/CTF
Environment="PATH=/root/www.cylsec.com/CTF/venv/bin"
EnvironmentFile=/root/www.cylsec.com/CTF/.env
ExecStart=/root/www.cylsec.com/CTF/venv/bin/gunicorn \
    --bind 127.0.0.1:5000 \
    --workers 2 \
    --timeout 120 \
    --access-logfile /var/log/cylvern-ctf.access.log \
    --error-logfile /var/log/cylvern-ctf.error.log \
    "app:create_app()"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
