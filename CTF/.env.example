# Example environment variables - copy to .env and fill values
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=replace-with-secure-password
ADMIN_ALERT_EMAIL=admin@example.com
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
SECRET_KEY=replace-with-a-random-secret
DATABASE_URL=sqlite:///cylvern.db
REDIS_LINK=

# Docker instance spawning
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_SOCKET=/var/run/docker.sock

# Public hostname/IP shown to users in spawned-instance URLs.
# Set this to your server's public IP or domain name.
# Leave as "localhost" for local development.
INSTANCE_HOST=localhost
